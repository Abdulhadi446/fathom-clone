# LLM access for the shared summarization function (src/lib/summarize.ts).
# Any OpenAI-compatible endpoint works. NEVER commit real values.
LLM_API_KEY=
LLM_API_BASE=https://api.githubcopilot.com
LLM_API_PATH=/chat/completions
LLM_MODEL=gpt-4o-mini
LLM_INTEGRATION_ID=copilot-chat

# SQLite location (defaults to ./data/fathom.db)
DATABASE_PATH=
