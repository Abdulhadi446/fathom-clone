# LLM access for the shared summarization function (src/lib/summarize.ts).
# Any OpenAI-compatible endpoint works. NEVER commit real values.
LLM_API_KEY=
LLM_API_BASE=https://api.githubcopilot.com
LLM_API_PATH=/chat/completions
LLM_MODEL=gpt-4o-mini
LLM_INTEGRATION_ID=copilot-chat

# SQLite location (defaults to ./data/fathom.db)
DATABASE_PATH=

# Email (Resend HTTP API) — used for email verification + password reset links.
# Resend's default sender only delivers to the Resend account's own address;
# set EMAIL_FROM to a domain you verified with Resend to reach anyone else.
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev
# Canonical origin used inside emailed links (must be the public HTTPS URL)
APP_URL=https://localhost

# Local speech-to-text (faster-whisper) for recorded audio — ops/install-stt.sh
STT_BIN=/srv/fathom/stt/bin/python
STT_SCRIPT=/srv/fathom/stt/transcribe.py
STT_MODEL=base.en

# Force Secure cookies (normally decided per-request from X-Forwarded-Proto)
COOKIE_SECURE=
